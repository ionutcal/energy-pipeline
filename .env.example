# Copy to .env and fill in.

# ENTSO-E token. Obtained in two steps:
#  1. create an account at https://transparency.entsoe.eu/
#  2. email transparency@entsoe.eu with the subject "RESTful API access"
#     and the email address you registered with in the body.
# The reply takes a few business days.
ENTSOE_API_KEY=

# Monitored countries, comma-separated ISO codes
COUNTRIES=RO

# How many days back to download on the first run
BACKFILL_DAYS=30

# PostgreSQL
DB_USER=postgres
DB_PASS=
DB_NAME=energy
DB_HOST=localhost
DB_PORT=5432

# Optional: fully overrides the connection (e.g. sqlite:///demo.db for testing)
# DATABASE_URL=

MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
