# Copiaza ca .env si completeaza.

# Token ENTSO-E. Se obtine in doi pasi:
#  1. cont pe https://transparency.entsoe.eu/
#  2. email la transparency@entsoe.eu, subiect "RESTful API access",
#     cu adresa de email folosita la inregistrare in corpul mesajului.
# Raspunsul vine in cateva zile lucratoare.
ENTSOE_API_KEY=

# Tari monitorizate, coduri ISO separate prin virgula
COUNTRIES=RO

# Cate zile in urma se descarca la prima rulare
BACKFILL_DAYS=30

# PostgreSQL
DB_USER=postgres
DB_PASS=
DB_NAME=energy
DB_HOST=localhost
DB_PORT=5432

# Optional: suprascrie complet conexiunea (ex. sqlite:///demo.db pentru teste)
# DATABASE_URL=

MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
